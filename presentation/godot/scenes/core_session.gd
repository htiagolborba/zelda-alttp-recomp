extends Node
## One 60 Hz C simulation. Godot supplies input and consumes copied JSON snapshots.
signal snapshot_updated(state: Dictionary)
signal failed(message: String)
var bridge: Object
var latest: Dictionary = {}
var connected := false
var running := false
var automated := false

func start(assets: String, sram: String, test_mode: bool) -> bool:
	automated = test_mode
	if FileAccess.get_sha256(assets) != "0fe2e4bd75d70f06fb9a74cd3a9cb336c838149b831b56e8792114a89292c793":
		failed.emit("Use the canonical USA resource bundle generated by the local extraction tool.")
		return false
	var extension := "res://native/alttp_core.gdextension"
	if not GDExtensionManager.is_extension_loaded(extension):
		GDExtensionManager.load_extension(extension)
	if not ClassDB.class_exists("AlttpCoreBridge"):
		failed.emit("Build the gameplay bridge with scripts/build-core-host.py --godot first.")
		return false
	bridge = ClassDB.instantiate("AlttpCoreBridge")
	latest = JSON.parse_string(bridge.call("request", "open", assets, sram))
	if not latest.get("ok", false):
		failed.emit(str(latest))
		return false
	connected = true
	running = true
	print("ALTTP_CORE_CONNECTED tick=0 source=upstream_c audio=scheduled_muted saves=read_only")
	return true

func _physics_process(_delta: float) -> void:
	if not running:
		return
	var buttons := _input_mask()
	if automated:
		buttons = 16 if int(latest.tick) >= 60 and int(latest.tick) < 90 else 0
	latest = JSON.parse_string(bridge.call("request", "step", str(buttons)))
	if not latest.get("ok", false):
		running = false
		failed.emit(str(latest))
		return
	snapshot_updated.emit(latest)

func _input_mask() -> int:
	var mask := 0
	var keyboard := [KEY_Z, KEY_A, KEY_SHIFT, KEY_ENTER, KEY_UP, KEY_DOWN,
		KEY_LEFT, KEY_RIGHT, KEY_X, KEY_S, KEY_C, KEY_V]
	for bit in range(keyboard.size()):
		if Input.is_physical_key_pressed(keyboard[bit]):
			mask |= 1 << bit
	var pads := Input.get_connected_joypads()
	if not pads.is_empty():
		var pad: int = pads[0]
		var mapping := [JOY_BUTTON_A, JOY_BUTTON_X, JOY_BUTTON_BACK, JOY_BUTTON_START,
			JOY_BUTTON_DPAD_UP, JOY_BUTTON_DPAD_DOWN, JOY_BUTTON_DPAD_LEFT, JOY_BUTTON_DPAD_RIGHT,
			JOY_BUTTON_B, JOY_BUTTON_Y, JOY_BUTTON_LEFT_SHOULDER, JOY_BUTTON_RIGHT_SHOULDER]
		for bit in range(mapping.size()):
			if Input.is_joy_button_pressed(pad, mapping[bit]):
				mask |= 1 << bit
		var axis := Vector2(Input.get_joy_axis(pad, JOY_AXIS_LEFT_X), Input.get_joy_axis(pad, JOY_AXIS_LEFT_Y))
		if axis.x < -0.35: mask |= 64
		if axis.x > 0.35: mask |= 128
		if axis.y < -0.35: mask |= 16
		if axis.y > 0.35: mask |= 32
	return mask

func reference_image() -> Image:
	if not running:
		return null
	var encoded: String = bridge.call("request", "frame", "")
	var bytes := encoded.hex_decode()
	if bytes.size() != 256 * 224 * 4:
		failed.emit("Invalid native reference-frame length")
		return null
	return Image.create_from_data(256, 224, false, Image.FORMAT_RGBA8, bytes)

func _exit_tree() -> void:
	running = false
	if is_instance_valid(bridge):
		bridge.free()
